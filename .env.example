# Copier en .env puis adapter. Ne JAMAIS committer le .env.

NODE_ENV=development
PORT=3001
WEB_ORIGIN=http://localhost:3000

# PostgreSQL (docker-compose.yml). Si le port 5432 est déjà pris (PostgreSQL local),
# définir POSTGRES_PORT=5433 (par ex.) et adapter le port dans DATABASE_URL.
# POSTGRES_PORT=5432
DATABASE_URL=postgresql://crypto:crypto@localhost:5432/crypto?schema=public

# Redis (docker-compose.yml)
REDIS_URL=redis://localhost:6379

# Jobs de fond BullMQ (surveillance de la perte journalière toutes les 5 minutes, évaluation des alertes
# toutes les minutes). Nécessitent Redis.
# false : tous désactivés, aucune connexion Redis (tests, instance qui ne doit pas exécuter les jobs).
BACKGROUND_JOBS_ENABLED=true

# Signaux du moteur d'analyse (Redis Stream `signals`, contrat : docs/SPEC.md section 7). Valeurs par défaut ci-dessous.
# SIGNAL_MIN_SCORE=0.6              # score minimal (0 à 1) pour agir ; sous ce seuil le signal est ignoré
# SIGNAL_MAX_AGE_SECONDS=300        # un signal plus ancien est périmé et ignoré
# SIGNAL_MAX_PRICE_DRIFT_PCT=2      # un achat est ignoré si le prix a bougé de plus de ce % depuis l'analyse

# Notifications Telegram : jeton du bot (créé avec @BotFather). Sans lui, le canal Telegram échoue
# avec le code « telegram_not_configured » (la notification reste dans la boîte de réception).
# Ne jamais committer ni journaliser ce jeton.
TELEGRAM_BOT_TOKEN=

# Chiffrement AES-256-GCM des clés API d'échange
# Clé maître de 32 octets encodée en base64. Générer avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Versionnée pour permettre la rotation : ajouter ENCRYPTION_KEY_V2 et passer ENCRYPTION_ACTIVE_KEY_VERSION=2.
ENCRYPTION_ACTIVE_KEY_VERSION=1
ENCRYPTION_KEY_V1=

# Mode de trading par défaut : PAPER (simulation) ou LIVE
TRADING_DEFAULT_MODE=PAPER

# Authentification
# Secret de signature des access tokens JWT (HS256), 32 caractères minimum. Générer avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
# Passer à false une fois le compte créé (inscription fermée).
AUTH_REGISTRATION_ENABLED=true

# Temps réel (WebSocket) — facultatif
# REALTIME_AUTH_TIMEOUT_MS=5000
# REALTIME_MAX_CONNECTIONS_PER_USER=5

# Push (Web Push) — `npm run vapid:generate` produit les trois premières lignes. La clé privée est secrète.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:vous@example.com

# Email (SMTP). En développement : Mailpit (docker run -d -p 1025:1025 -p 8025:8025 axllent/mailpit)
# SMTP_HOST=127.0.0.1
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false        # TLS dès la connexion (par défaut vrai sur le port 465)
# SMTP_REQUIRE_TLS=true    # exigé sauf vers la machine locale ; false pour un serveur interne sans TLS
# EMAIL_FROM=Veille <veille@example.com>
# Signaux du moteur (voir docs/DECISIONS.md, D114) — DÉSACTIVÉS PAR DÉFAUT : le backtest du moteur n'a démontré
# aucun avantage de sa stratégie. Seule la valeur exacte « true » active.
# SIGNALS_ENABLED=true        # l'API consomme le stream `signals` (PAPER : observer sans risque)
# SIGNALS_ALLOW_LIVE=true     # un signal peut passer un ordre pour un utilisateur en mode LIVE : à ne pas activer