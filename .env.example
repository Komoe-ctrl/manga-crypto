# Copier en .env puis adapter. Ne JAMAIS committer le .env.

NODE_ENV=development
PORT=3001
WEB_ORIGIN=http://localhost:3000

# PostgreSQL (docker-compose.yml). Si le port 5432 est déjà pris (PostgreSQL local),
# définir POSTGRES_PORT=5433 (par ex.) et adapter le port dans DATABASE_URL.
# POSTGRES_PORT=5432
DATABASE_URL=postgresql://crypto:crypto@localhost:5432/crypto?schema=public

# Redis (docker-compose.yml)
REDIS_URL=redis://localhost:6379

# Chiffrement AES-256-GCM des clés API d'échange
# Clé maître de 32 octets encodée en base64. Générer avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Versionnée pour permettre la rotation : ajouter ENCRYPTION_KEY_V2 et passer ENCRYPTION_ACTIVE_KEY_VERSION=2.
ENCRYPTION_ACTIVE_KEY_VERSION=1
ENCRYPTION_KEY_V1=

# Mode de trading par défaut : PAPER (simulation) ou LIVE
TRADING_DEFAULT_MODE=PAPER
